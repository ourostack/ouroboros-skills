{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen offline expected-cell inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cells"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cells": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/cell"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoningEffort", "contextTier", "invocationMode", "promptSha256", "runtimeOptionsSha256"],
      "properties": {
        "provider": {"const": "copilot"},
        "model": {"enum": ["gpt-6-astra", "claude-opus-5"]},
        "reasoningEffort": {"const": "high"},
        "contextTier": {"const": "default"},
        "invocationMode": {"enum": ["native-subject", "empty-judge"]},
        "promptSha256": {"$ref": "#/$defs/sha"},
        "runtimeOptionsSha256": {"$ref": "#/$defs/sha"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caseId", "candidateId", "repetition", "executionKind", "subject", "judge"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "caseId": {"$ref": "#/$defs/id"},
        "candidateId": {"$ref": "#/$defs/id"},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 256},
        "executionKind": {"enum": ["subject_with_judge", "deterministic"]},
        "subject": {"anyOf": [{"allOf": [{"$ref": "#/$defs/role"}, {"properties": {"invocationMode": {"const": "native-subject"}}}]}, {"type": "null"}]},
        "judge": {"anyOf": [{"allOf": [{"$ref": "#/$defs/role"}, {"properties": {"invocationMode": {"const": "empty-judge"}}}]}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"executionKind": {"const": "deterministic"}}}, "then": {"properties": {"subject": {"type": "null"}, "judge": {"type": "null"}}}},
        {"if": {"properties": {"executionKind": {"const": "subject_with_judge"}}}, "then": {"properties": {"subject": {"$ref": "#/$defs/role"}, "judge": {"$ref": "#/$defs/role"}}}}
      ]
    }
  }
}
