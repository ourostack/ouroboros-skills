{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role-separated fixture inputs",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "fixtures"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "fixtures": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "requiresAdmittedProducerBinding", "files"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "requiresAdmittedProducerBinding": {"type": "boolean"},
          "files": {
            "type": "array", "maxItems": 4096,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["role", "sourcePath", "targetPath", "sha256"],
              "properties": {
                "role": {"enum": ["subject", "held_out", "canonical_fixture_input"]},
                "sourcePath": {"type": "string", "minLength": 1, "maxLength": 1024},
                "targetPath": {"type": "string", "minLength": 1, "maxLength": 1024},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
